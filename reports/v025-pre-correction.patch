+      detonate(b, g);
+      continue;
+    }
+    // Grounded grenades must be seen at close range. No perfect mid-flight landing
+    // prediction or squad-wide omniscient awareness is granted.
+    if (t >= 1)
+      for (const u of b.units) {
+        if (
+          !u.active ||
+          distance(u, g.position) > 6 ||
+          !sight(u, g.position) ||
+          u.grenadeThreat?.id === g.id
