+    (g) => !g.detonatedAt || b.time - g.detonatedAt < 0.6,
+  );
+}
+function evade(b, u, dt) {
+  const t = u.grenadeThreat;
+  if (!t || b.time < t.readyAt) return false;
+  const g = b.grenades.find((g) => g.id === t.id && !g.detonatedAt);
